# NooBaa endpoint process environment (loaded by noobaa.service).
# Override locally as needed; RPM installs this as %config(noreplace).

# jemalloc is bundled in the RPM (see /usr/local/noobaa-core/lib/).
# Clear LD_PRELOAD= to fall back to glibc malloc.
LD_PRELOAD=/usr/local/noobaa-core/lib/libjemalloc.so.2

# jemalloc default decay (10s) on a background thread. background_thread is the
# main reclaim enabler; tune dirty_decay_ms / muzzy_decay_ms if needed.
MALLOC_CONF=dirty_decay_ms:10000,muzzy_decay_ms:10000,background_thread:true
